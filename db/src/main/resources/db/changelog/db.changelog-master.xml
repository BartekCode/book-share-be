<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="001-create-schema" author="bartek">
        <sqlFile
                path="changesets/init.sql"
                relativeToChangelogFile="true"
                stripComments="true"
                splitStatements="false"/>
    </changeSet>
    <changeSet id="002-update-book" author="bartek">
        <sqlFile
                path="changesets/updateBook.sql"
                relativeToChangelogFile="true"
                stripComments="true"
                splitStatements="false"/>
    </changeSet>
    <changeSet id="003-add-msg_column" author="bartek">
        <sqlFile
                path="changesets/bookRequestMsgColumn.sql"
                relativeToChangelogFile="true"
                stripComments="true"
                splitStatements="false"/>
    </changeSet>
    <changeSet id="004-add-indexes" author="bartek">
        <sqlFile
                path="changesets/indexes.sql"
                relativeToChangelogFile="true"
                stripComments="true"
                splitStatements="false"/>
    </changeSet>
    <changeSet id="005-add-security-changes" author="bartek">
        <sqlFile
                path="changesets/securityChanges.sql"
                relativeToChangelogFile="true"
                stripComments="true"
                splitStatements="false"/>
    </changeSet>
</databaseChangeLog>